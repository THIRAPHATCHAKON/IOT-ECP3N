#include <WiFi.h>
#include <HTTPClient.h>

// --------- กำหนด WiFi ------------
const char* ssid = "IOT-RMUTI";
const char* password = "@1111111111111!";

// URL Google Apps Script
const char* googleScriptURL = "https://script.google.com/macros/s/AKfycbyi2O913iDpG6zvXsC4E6VZuVJVA1ERQBnBPROauGd7xOAzsNpIA1TRLsto5CkjpuWUSQ/exec";

void setup() {
  Serial.begin(115200);
  delay(1000);

  // เชื่อมต่อ Wi-Fi
  WiFi.begin(ssid, password);
  Serial.print("Connecting to Wi-Fi");
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected to Wi-Fi");

  randomSeed(analogRead(0)); // สุ่ม seed
}

void loop() {

  // ----- สุ่มค่าอุณหภูมิ – ความชื้น -----
  float temperature = random(250, 360) / 10.0;  // 25.0°C - 36.0°C
  float humidity    = random(400, 900) / 10.0;  // 40% - 90%

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.print(" °C, Humidity: ");
  Serial.print(humidity);
  Serial.println(" %");

  // ---------- ส่งข้อมูล -----------
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    String url = String(googleScriptURL)
                 + "?temp=" + String(temperature)
                 + "&humi=" + String(humidity);

    http.begin(url);

    int httpCode = http.GET();
    if (httpCode > 0) {
      Serial.println("Data sent successfully!");
    } else {
      Serial.println("Failed to send data.");
    }
    http.end();
  }

  delay(30000); // ทุก 30 วินาที
}

