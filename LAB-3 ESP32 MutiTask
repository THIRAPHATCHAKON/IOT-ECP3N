void setup() {
  Serial.begin(115200);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWiFi Connected!");

  xTaskCreatePinnedToCore(taskWebControl, "WebTask", 8192, NULL, 1, NULL, 0);
  xTaskCreatePinnedToCore(taskLED, "LEDTask", 2048, NULL, 1, NULL, 1);
  xTaskCreatePinnedToCore(taskWebControl2, "WebTask2", 8192, NULL, 1, NULL, 0);
  xTaskCreatePinnedToCore(taskLED2, "LEDTask2", 2048, NULL, 1, NULL, 1);
}

void loop() {}
